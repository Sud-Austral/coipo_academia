# Fase de conversión — TEMPORAL. Copiar como .env.migracion (chmod 600).
#
# Apunta la MISMA imagen al MariaDB desechable en vez de a PostgreSQL. Cuando la
# migración termine, este archivo y el volumen de MariaDB se borran.
#
# ESTE ARCHIVO SE VERSIONA: nunca escribir claves reales aquí.

# ─── MariaDB temporal (contenedor mariadb-tmp) ──────────────────────────────
MOODLE_DBTYPE=mariadb
DATABASE_HOST=mariadb-tmp
DATABASE_PORT=3306
# El volcado no trae CREATE DATABASE ni USE (verificado en su cabecera): se
# carga en la base que se le indique. Se conserva el nombre de origen para que
# los comandos de docs/MIGRACION.md se lean igual que el archivo.
DATABASE_NAME=bitnami_moodle
DATABASE_USER=root
MOODLE_DBPREFIX=mdl_

# Generar ambas con: openssl rand -hex 32. Se descartan al terminar.
MARIADB_ROOT_PASSWORD=
DATABASE_PASSWORD=

# ─── Sitio (durante la conversión se accede directo, sin Nginx) ─────────────
MOODLE_WWWROOT=http://172.31.2.41:8115
MOODLE_REVERSEPROXY=false
MOODLE_SSLPROXY=false

# Innegociable en esta fase: son ~2.800 correos reales de funcionarios.
MOODLE_NOEMAILEVER=true
MOODLE_DEBUG=false

# ─── Rutas del host ─────────────────────────────────────────────────────────
MOODLEDATA_HOST_PATH=/opt/moodledata/coipo_moodle
DUMP_HOST_PATH=/opt/migracion/coipo_moodle

APP_PORT=8115
MOODLE_VERSION=v4.5.10
