# Academia CONAF v2 — INSTANCIA PARALELA, no es producción.
#
# Corre Moodle 5.2.1 sobre PHP 8.4, INSTALADO DE CERO. El campus actual
# (coipo_moodle, 4.5.10 sobre PHP 8.3) sigue sin tocarse y queda como archivo
# histórico mientras siga vivo: de él no se hereda base, ni cursos, ni archivos.
#
# ESTE ARCHIVO NO SE COPIA TAL CUAL. El .env real se escribe a mano en
# /opt/apps/coipo_academia/ del servidor (chmod 600) y nunca se commitea.
#
# Qué es esta instancia
# ────────────────────
# Un segundo Moodle en el MISMO servidor 172.31.2.41, con base y moodledata
# propios. Desde el 31-08-2026 no es un laboratorio sobre una copia: es LA
# Academia, instalada limpia y construida con los scripts de academia/cli
# (7 áreas, 8 campos, cohortes, competencias, rol de Gestor de Área).
#
# No trae usuarios, no trae cursos y no trae archivos. Los 2.869 funcionarios y
# los 37 cursos del campus actual se quedan donde están; qué se hace con ellos
# es una decisión posterior a esta y no condiciona nada de este archivo.
#
#   coipo_moodle    8115   academia_prod   Moodle 4.5.10 · PHP 8.3   producción
#   coipo_academia  8116   academia_v2     Moodle 5.2.1  · PHP 8.4   esta
#
# Las mismas dos comprobaciones que documenta .env.example valen aquí:
#
#   cd /opt/apps/coipo_academia
#   diff <(grep -oE '^[A-Z_]+=' .env.v2.example | sort -u) \
#        <(grep -oE '^[A-Z_]+=' .env            | sort -u)
#   grep -oE '^[A-Z_]+=' .env | sort | uniq -d      # vacío = correcto

# ─── Base de datos ──────────────────────────────────────────────────────────
# Mismo servidor y MISMO ROL que producción; lo único distinto es la base.
# db/setup_bd_v2.sql la crea VACÍA —ya no hay pg_dump desde academia_prod— y
# quien la llena es admin/cli/install_database.php de la propia imagen. Tiene
# que estar vacía cuando eso corra: acá lo primero que pasa es una instalación,
# no el upgrade de un esquema heredado.
MOODLE_DBTYPE=pgsql
DATABASE_HOST=172.31.2.40
DATABASE_PORT=5432
DATABASE_USER=academia
DATABASE_NAME=academia_v2
# La misma clave que usa producción — es el mismo rol. Va SOLO en el .env del servidor.
DATABASE_PASSWORD=
# Se queda en mdl_. Con una instalación limpia el prefijo pasa a ser una
# elección libre por primera vez —antes lo imponía el volcado— y la tentación es
# cambiarlo. No conviene: los scripts de academia/cli usan la API de Moodle y ni
# se enterarían, pero TODA consulta suelta escrita en este repositorio —las de
# db/setup_bd_v2.sql, las de academia/README.md, las de docs/— dice mdl_, y con
# otro prefijo fallan de a una, en caliente y sin patrón.
MOODLE_DBPREFIX=mdl_

# El PostgreSQL de CONAF rechaza la negociación GSSAPI y TLS. Sin estas dos la
# conexión falla con "could not initiate GSSAPI security context".
PGGSSENCMODE=disable
PGSSLMODE=disable

# ─── Sitio ─────────────────────────────────────────────────────────────────
# La Academia tiene dominio propio: academia2.conaf.cl. NO reemplaza a
# academia.conaf.cl — los dos sitios conviven en el mismo servidor:
#
#   academia.conaf.cl   →  coipo_moodle    :8115   el campus actual, intacto
#   academia2.conaf.cl  →  coipo_academia  :8116   esta Academia
#
# Estado del dominio medido el 31-08-2026:
#   nslookup academia2.conaf.cl        → 172.31.2.100      ✅ el DNS ya resuelve
#   http://academia2.conaf.cl/         → 307 a https       ✅ el Alteon lo conoce
#   TLS con SNI academia2.conaf.cl     → handshake ok      ✅ el certificado es
#                                                            comodín *.conaf.cl
#   GET / con Host: academia2.conaf.cl → RESPUESTA VACÍA    ❌ falta el backend
#
# O sea: falta el servicio virtual del Alteon que mande este nombre al pool del
# 172.31.2.41, y falta instalar docs/nginx-academia2.conf en el servidor. Hasta
# que las dos cosas estén, el dominio no responde por mucho que el .env esté bien.
#
# LAS TRES LÍNEAS DE ABAJO VAN JUNTAS. Es el error más caro de este proyecto:
#
#   · https:// con sslproxy=false → Moodle genera las URLs de sus recursos con
#     http:// dentro de una página servida por https://, el navegador las bloquea
#     por contenido mixto y el sitio aparece SIN CSS NI JS, sin ningún error
#     visible. Pasó exactamente eso con academia.conaf.cl el 30-07-2026.
#   · http:// con sslproxy=true → las cookies salen marcadas Secure, el navegador
#     no las manda sobre HTTP y el login deja de funcionar.
#   · reverseproxy se queda en FALSE aunque haya DOS proxys delante (Alteon y
#     Nginx): lib/setuplib.php aborta si el Host recibido coincide con el de
#     wwwroot, que es justo lo que pasa acá.
#
# MIENTRAS EL ALTEON NO ESTÉ CONFIGURADO se puede trabajar por IP, pero hay que
# cambiar DOS líneas a la vez, no una:
#   MOODLE_WWWROOT=http://172.31.2.41:8116
#   MOODLE_SSLPROXY=false
#
# Y al cambiar wwwroot, siempre las dos cosas después:
#   docker compose exec -u www-data app php admin/cli/purge_caches.php
#   docker compose exec -u www-data app php admin/cli/build_theme_css.php
MOODLE_WWWROOT=https://academia2.conaf.cl
MOODLE_REVERSEPROXY=false
MOODLE_SSLPROXY=true

# ─── SEGURIDAD: correo saliente ─────────────────────────────────────────────
# Se queda en TRUE, pero por otra razón que antes. Hasta el 31-08-2026 esto
# protegía los 2.869 correos institucionales que venían dentro del clon de
# producción. Ya no hay clon ni hay 2.869 buzones: la Academia se instala vacía.
#
# Lo que sí hay es un puñado de cuentas nominadas de CONAF —las de quienes
# construyen y prueban el sitio— y esas direcciones son tan reales como las
# otras. Un sitio en construcción manda correo igual: al crear una cuenta, al
# matricular, al escribir en un foro, y el cron corre cada minuto. Con una sola
# dirección real adentro basta para que a alguien le lleguen avisos de un sitio
# que todavía no existe oficialmente, y esos son los avisos que después nadie
# sabe explicar.
#
# El costo de tenerlo en true hay que decirlo, porque es real: «¿Olvidó su
# contraseña?» no funciona, y el flujo de correo entero —confirmación de
# matrícula, recuperación de clave, avisos de curso— NO queda probado. Es un
# flujo que tarde o temprano hay que verificar, y verificarlo exige apagarlo.
#
# Cómo se apaga cuando llegue el momento, y no antes: con SMTP institucional ya
# configurado en el sitio, con la lista de destinatarios acotada a las cuentas
# nominadas, y devolviéndolo a true al terminar la prueba. En ese orden.
MOODLE_NOEMAILEVER=true

# En v2 sí tiene sentido encenderlo puntualmente para diagnosticar, y ahora sale
# más barato que antes: en un sitio recién instalado no hay datos personales que
# filtrar. Aun así queda en false por defecto y se devuelve a false al terminar,
# porque con debug activo Moodle escupe rutas, consultas y trazas en la propia
# página — y el día que la Academia reciba a su primer funcionario nadie se va a
# acordar de que quedó encendido.
MOODLE_DEBUG=false

# ─── Rutas del host ─────────────────────────────────────────────────────────
# moodledata propio y VACÍO. Desde el 31-08-2026 no se clona nada: la Academia
# es una instalación limpia de Moodle 5.2.1 y no hereda ni un archivo del campus
# actual. El bloque que había acá explicaba cómo clonar los 11 GB de filedir por
# hardlink; ya no aplica y por eso se fue entero.
#
# CÓMO SE PREPARA — tres líneas, antes de levantar el contenedor:
#
#   mkdir -p /opt/moodledata/coipo_academia
#   chown 33:33 /opt/moodledata/coipo_academia
#   chmod 2775  /opt/moodledata/coipo_academia
#
# Y nada más. Los subdirectorios (filedir/, cache/, localcache/, temp/, muc/,
# sessions/, trashdir/, lang/) los crea Moodle solo la primera vez que los
# necesita — para eso están make_writable_directory() y compañía en
# lib/setuplib.php. Crearlos a mano no adelanta nada y sí puede dejarlos con el
# dueño equivocado.
#
# ─── EL UID 33 NO ES UN DETALLE ─────────────────────────────────────────────
# 33 es www-data dentro del contenedor. Si la carpeta queda con dueño root,
# install_database.php no puede escribir y el sitio no llega ni a instalarse. Y
# si queda bien pero después alguien corre un comando de Moodle SIN -u www-data,
# lo que ese comando escriba queda con dueño root y el sitio pierde la escritura
# a mitad del árbol. Es el error más común de este proyecto y el que peor se
# diagnostica. El 2775 (setgid) es para que los subdirectorios hereden el grupo,
# que es lo mismo que pide $CFG->directorypermissions = 02775 en
# docker/config.php.
#
# ─── POR QUÉ FUERA DE /opt/apps/ ────────────────────────────────────────────
# Esta razón NO cambió con la instalación limpia, y es la única del bloque
# anterior que había que conservar: el deploy sincroniza /opt/apps/<repo>/ con
# rsync --delete, así que todo lo que esté ahí dentro y no esté en el
# repositorio SE BORRA en el siguiente push a main. Un moodledata bajo
# /opt/apps/ se lo lleva el primer despliegue, sin aviso y sin error.
#
# Hoy la carpeta está vacía y perderla no dolería. En tres meses tendrá el único
# ejemplar del contenido de los cursos nuevos, que a diferencia del campus
# actual no está copiado en ninguna otra parte.
#
# ─── SI ESTA VARIABLE FALTA, EL COMPOSE NO LEVANTA ──────────────────────────
# docker-compose.yml ya no trae valor por defecto para esta ruta: los dos
# volumes usan ${MOODLEDATA_HOST_PATH:?...} y `docker compose up` aborta con ese
# mensaje. Es deliberado. El defecto que había antes apuntaba a
# /opt/moodledata/coipo_moodle, o sea que un .env incompleto en ESTA instancia
# montaba los 12 GB del campus vivo dentro de un sitio recién instalado, con
# permiso de escritura y con un cron corriendo cada minuto. Fallar ruidosamente
# es la única opción defendible.
#
# Ojo con dónde se lee: la interpolación de ${...} la resuelve docker compose
# desde el archivo .env del directorio del proyecto, no desde el `env_file:` del
# servicio. Acá son el mismo archivo y por eso funciona — pero si alguien lo
# renombra, el compose deja de levantar aunque la variable esté escrita.
MOODLEDATA_HOST_PATH=/opt/moodledata/coipo_academia

# ─── Puerto interno del contenedor ──────────────────────────────────────────
# 8116, porque 8115 lo ocupa coipo_moodle. Nunca 80: choca con el Nginx del
# servidor y se caen también las otras apps.
APP_PORT=8116

# ─── Versión de Moodle que construye la imagen ──────────────────────────────
# Requisitos de 5.2, leídos del public/admin/environment.xml del propio tag
# v5.2.1 y no de la documentación: PHP mínimo 8.3.0 sin ningún <RESTRICT> arriba
# (por eso la imagen puede ir en 8.4), y PostgreSQL mínimo 16. CONAF tiene 17.10.
#
# OJO, ESTE ARCHIVO MENTÍA ACÁ. Decía que v5.2.1 era "el último parche publicado
# de la rama 5.2". Es falso: al 01-09-2026 ya existe v5.2.2, etiquetada el
# 08-08-2026 —comprobado con git ls-remote sobre github.com/moodle/moodle—. Se
# queda en v5.2.1 porque es la versión con la que se decidió instalar y nadie ha
# revisado todavía qué trae la .2, NO porque sea la más nueva. Subir de parche
# es un cambio de una línea acá y un redespliegue; está pendiente de revisar.
#
# POR QUÉ 5.2 Y NO ESPERAR A 5.3 LTS. Decidido el 01-09-2026: se instala ahora.
# Antes la respuesta era "para ensayar el salto 4.5 -> 5.x sobre un clon
# desechable", y ese argumento se murió el 31-08-2026: no hay clon, no hay salto
# y la instalación es limpia, así que no se actualiza nada. El que queda es más
# simple: 5.2 es la rama estable y soportada de hoy (seguridad hasta el 04-10-2027)
# y esperar a octubre congelaba dos meses de construcción a cambio de nada. En
# octubre se sube a 5.3 LTS y sale barato justamente porque el sitio está armado
# con los scripts de academia/cli —son idempotentes y se vuelven a correr—. Lo
# caro sería llegar a octubre sin nada que actualizar.
#
# OJO: 5.2 movió la raíz web a public/. El Dockerfile ya apunta el DocumentRoot
# ahí, pero si algún día se baja MOODLE_VERSION a una 4.x hay que revertir eso
# también, o el sitio responde `rootdirpublic` y no carga. Y con la base ya
# instalada por 5.2 eso no alcanza: Moodle no arranca contra un esquema más
# nuevo que su código. Bajar de versión después de instalar es borrar la base y
# empezar de nuevo — que ahora, sin datos heredados, cuesta poco.
MOODLE_VERSION=v5.2.1

# ─── Concurrencia: no es una variable, es un reparto ────────────────────────
# No hay variable de entorno para esto. MaxRequestWorkers vive en
# docker/apache-moodle.conf, y en ESTE repositorio está en 6 a propósito.
#
# El CONNECTION LIMIT es del ROL `academia`, no de la base, así que las dos
# instancias se reparten un solo techo:
#
#     50  coipo_moodle (campus del 8115, sin tocar)
#   +  6  coipo_academia (esta)
#   +  2  los dos contenedores cron
#   +  2  margen: los `exec` de academia/cli y un psql de diagnóstico
#   ───────
#     60  el límite del rol, exacto y sin sobra
#
# El 60 lo dejó el administrador de 172.31.2.40 el 31-07-2026, y el 31-08-2026
# se decidió que ahí se queda: NO se pide otra ampliación y NO se crea un rol de
# PostgreSQL aparte para la Academia. Comprobarlo igual antes de levantar la
# instancia — es el único número del que depende todo lo demás:
#
#   psql -h 172.31.2.40 -U academia -d academia_v2 -c \
#     "SELECT rolname, rolconnlimit FROM pg_roles WHERE rolname='academia';"
#
# Con el tope por debajo del límite, las peticiones sobrantes ESPERAN en Apache
# en vez de fallar: lento es mejor que roto. Si se pasa, el usuario ve un 500 y
# el log dice "FATAL: too many connections for role academia".
#
# EL 6 DEJÓ DE SER TEMPORAL. Antes acá decía "al promover v2, devolverlo a 50";
# ya no se promueve nada ni se apaga nada, los dos sitios conviven. El reparto
# de destino (36 para el campus, 16 para la Academia), la regla que lo recalcula
# y —sobre todo— EL ORDEN en que se cambian los dos números están en
# docker/apache-moodle.conf. Lo único que hay que retener acá: el
# MaxRequestWorkers del 8115 vive en OTRO repositorio, primero baja ese y
# después sube este. Al revés, la ventana entre los dos despliegues suma 68
# sobre 60 y el 500 le toca al sitio que tiene 2.869 personas adentro.
#
# ─── Ver venir que el reparto se quedó corto ────────────────────────────────
# Son dos síntomas distintos y se confunden siempre:
#
#   · "FATAL: too many connections for role academia" y un 500 → el reparto está
#     MAL SUMADO: los dos MaxRequestWorkers pasan del rolconnlimit. Es un error
#     de configuración, no de capacidad.
#   · Nada en el log y páginas lentas → el reparto está bien sumado y CORTO:
#     Apache está encolando. Como no hay error que buscar, es la que cuesta ver.
#
# El semáforo — cuánto queda del techo del rol:
#
#   psql -h 172.31.2.40 -U academia -d academia_v2 -c "
#     SELECT r.rolconnlimit                                  AS techo,
#            count(a.pid)                                    AS en_uso,
#            r.rolconnlimit - count(a.pid)                   AS libres,
#            round(100.0 * count(a.pid) / r.rolconnlimit, 1) AS pct
#       FROM pg_roles r
#       LEFT JOIN pg_stat_activity a ON a.usename = r.rolname
#      WHERE r.rolname = 'academia'
#      GROUP BY r.rolconnlimit;"
#
# Y el desglose, que es el que dice CUÁL de las dos se está comiendo el techo:
#
#   psql -h 172.31.2.40 -U academia -d academia_v2 -c "
#     SELECT datname,
#            count(*)                                 AS total,
#            count(*) FILTER (WHERE state = 'active') AS activas,
#            count(*) FILTER (WHERE state = 'idle')   AS ociosas
#       FROM pg_stat_activity
#      WHERE usename = 'academia'
#      GROUP BY datname
#      ORDER BY total DESC;"
#
# Tres cosas de estas consultas que no se ven:
#
# · pg_stat_activity es una FOTO del instante. Un peak de tres segundos no sale
#   si se mira a los cinco. Para que signifique algo hay que muestrear —
#   `watch -n 5 psql ...` durante la hora de más uso—, no una corrida suelta.
# · Que se vea el `state` de las sesiones de la OTRA instancia es un regalo de
#   la decisión de no crear un rol aparte: PostgreSQL enmascara `state` y
#   `query` de las sesiones de otros roles, y acá las dos instancias SON el
#   mismo rol. El `count(*)` funcionaría igual —las filas siempre se ven—, pero
#   el desglose activas/ociosas no. Si algún día se separa el rol, esta consulta
#   deja de servir tal cual y hay que pedir pg_read_all_stats.
# · Los umbrales. Si `libres` baja de 6, el margen se acabó y el próximo pg_dump
#   o el próximo script de academia/cli no va a poder conectarse. Si el `total`
#   de una base toca su MaxRequestWorkers en dos muestras de la misma hora, ese
#   lado se quedó corto y hay que mover conexiones desde el otro — con el orden
#   de docker/apache-moodle.conf, primero el que baja.
